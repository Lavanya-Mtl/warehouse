cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# Environment & Secrets
.env
.venv
venv/
ENV/

# Database
db.sqlite3
*.db

# Testing
.coverage
htmlcov/
.tox/
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Django
*.log
local_settings.py
EOF